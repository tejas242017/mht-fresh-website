# Local development only. Never commit real credentials.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key
MHT_MEDIA_ADMIN_TOKEN=replace_with_a_long_random_admin_token
# Cloudflare Pages production uses environment variables/secrets and a D1 binding.
# D1 binding name: MHT_MEDIA_DB
